  "body": [
    "namespace poly {",
    "template <int MOD> struct Poly {",
    "  using Z = Mint<MOD>;",
    "  static constexpr int G = 3;",
    "  static void ntt(vc<Z> &a, bool inv = false) {",
    "    int n = a.size();",
    "    for (int i = 1, j = 0; i < n; i++) {",
    "      int bit = n >> 1;",
    "      for (; j & bit; bit >>= 1)",
    "        j ^= bit;",
    "      j |= bit;",
    "      if (i < j)",
    "        swap(a[i], a[j]);",
    "    }",
    "    for (int len = 1; len < n; len <<= 1) {",
    "      Z w = qpow(Z(G), (MOD - 1) / (len << 1));",
    "      if (inv)",
    "        w = w.inv();",
    "      for (int i = 0; i < n; i += len << 1) {",
    "        Z wk = 1;",
    "        for (int j = 0; j < len; j++, wk *= w) {",
    "          Z u = a[i + j], v = a[i + j + len] * wk;",
    "          a[i + j] = u + v;",
    "          a[i + j + len] = u - v;",
    "        }",
    "      }",
    "    }",
    "    if (inv) {",
    "      Z ni = Z(n).inv();",
    "      for (auto &x : a)",
    "        x *= ni;",
    "    }",
    "  }",
    "  static vc<Z> conv(const vc<Z> &a, const vc<Z> &b) {",
    "    int n = a.size(), m = b.size();",
    "    if (!n || !m)",
    "      return {};",
    "    if (min(n, m) <= 60) {",
    "      vc<Z> c(n + m - 1);",
    "      F(i, 0, n - 1) F(j, 0, m - 1) c[i + j] += a[i] * b[j];",
    "      return c;",
    "    }",
    "    int len = 1;",
    "    while (len < n + m - 1)",
    "      len <<= 1;",
    "    bool same = a == b;",
    "    vc<Z> f(a), g(b);",
    "    f.resize(len), g.resize(len);",
    "    ntt(f);",
    "    if (same)",
    "      g = f;",
    "    else",
    "      ntt(g);",
    "    F(i, 0, len - 1) f[i] *= g[i];",
    "    ntt(f, true);",
    "    f.resize(n + m - 1);",
    "    return f;",
    "  }",
    "  static vc<Z> der(const vc<Z> &f) {",
    "    int n = f.size();",
    "    if (n <= 1)",
    "      return {};",
    "    vc<Z> g(n - 1);",
    "    F(i, 1, n - 1) g[i - 1] = f[i] * i;",
    "    return g;",
    "  }",
    "  static Z invnum(int n) {",
    "    static vc<Z> iv{0, 1};",
    "    while ((int)iv.size() <= n) {",
    "      int k = iv.size();",
    "      iv.push_back(-Z(MOD / k) * iv[MOD % k]);",
    "    }",
    "    return iv[n];",
    "  }",
    "  static vc<Z> inte(const vc<Z> &f) {",
    "    int n = f.size();",
    "    vc<Z> g(n + 1);",
    "    F(i, 1, n) g[i] = f[i - 1] * invnum(i);",
    "    return g;",
    "  }",
    "  static int count(const vc<Z> &f) {",
    "    int t = 0;",
    "    F(i, 0, (int)f.size() - 1) if (f[i].val()) t++;",
    "    return t;",
    "  }",
    "  static bool sparse(const vc<Z> &f, int n, int t) {",
    "    int c = count(f);",
    "    return c <= t && (ll)c * n <= 100000000;",
    "  }",
    "  static vc<Z> inv(const vc<Z> &f, int n) {",
    "    assert(f[0].val());",
    "    if (n <= 0)",
    "      return {};",
    "    if (sparse(f, n, 200))",
    "      return inv_sparse(f, n);",
    "    return inv_dense(f, n);",
    "  }",
    "  static vc<Z> inv_dense(const vc<Z> &f, int n) {",
    "    vc<Z> g{f[0].inv()};",
    "    for (int m = 1; m < n; m <<= 1) {",
    "      int len = min(m << 1, n), sz = m << 1;",
    "      vc<Z> a(sz), b(sz);",
    "      F(i, 0, min((int)f.size(), sz) - 1) a[i] = f[i];",
    "      F(i, 0, m - 1) b[i] = g[i];",
    "      ntt(a), ntt(b);",
    "      F(i, 0, sz - 1) a[i] *= b[i];",
    "      ntt(a, true);",
    "      F(i, 0, m - 1) a[i] = 0;",
    "      ntt(a);",
    "      F(i, 0, sz - 1) a[i] *= b[i];",
    "      ntt(a, true);",
    "      g.resize(len);",
    "      F(i, m, len - 1) g[i] = -a[i];",
    "    }",
    "    return g;",
    "  }",
    "  static vc<Z> inv_sparse(const vc<Z> &f, int n) {",
    "    vc<pair<int, Z>> d;",
    "    F(i, 1, (int)f.size() - 1) if (f[i].val()) d.push_back({i, f[i]});",
    "    Z g0 = f[0].inv();",
    "    vc<Z> g(n);",
    "    g[0] = g0;",
    "    F(i, 1, n - 1) {",
    "      Z s = 0;",
    "      for (auto &[k, v] : d) {",
    "        if (k > i)",
    "          break;",
    "        s += v * g[i - k];",
    "      }",
    "      g[i] = -s * g0;",
    "    }",
    "    return g;",
    "  }",
    "  static vc<Z> ln(const vc<Z> &f, int n) {",
    "    assert(f[0].val() == 1);",
    "    if (n <= 0)",
    "      return {};",
    "    if (sparse(f, n, 1000))",
    "      return ln_sparse(f, n);",
    "    return ln_dense(f, n);",
    "  }",
    "",
    "  static vc<Z> ln_dense(const vc<Z> &f, int n) {",
    "    vc<Z> d = der(f);",
    "    d.resize(n - 1);",
    "    vc<Z> g = inte(conv(d, inv(f, n - 1)));",
    "    g.resize(n);",
    "    return g;",
    "  }",
    "  static vc<Z> ln_sparse(const vc<Z> &f, int n) {",
    "    vc<pair<int, Z>> d;",
    "    F(i, 1, (int)f.size() - 1) if (f[i].val()) d.push_back({i, f[i]});",
    "    vc<Z> dp(max(n - 1, 0));",
    "    F(i, 0, n - 2) {",
    "      Z s = i + 1 < (int)f.size() ? f[i + 1] * (i + 1) : Z(0);",
    "      for (auto &[k, v] : d) {",
    "        if (k > i)",
    "          break;",
    "        s -= v * dp[i - k];",
    "      }",
    "      dp[i] = s;",
    "    }",
    "    vc<Z> g(n);",
    "    F(i, 0, n - 2) g[i + 1] = dp[i] * invnum(i + 1);",
    "    return g;",
    "  }",
    "  static vc<Z> exp(const vc<Z> &f, int n) {",
    "    assert(f.empty() || f[0].val() == 0);",
    "    if (n <= 0)",
    "      return {};",
    "    if (sparse(f, n, 800))",
    "      return exp_sparse(f, n);",
    "    return exp_dense(f, n);",
    "  }",
    "  static vc<Z> exp_sparse(const vc<Z> &f, int n) {",
    "    vc<pair<int, Z>> d;",
    "    F(i, 1, (int)f.size() - 1) if (f[i].val()) d.push_back({i, f[i] * i});",
    "    vc<Z> g(n);",
    "    g[0] = Z(1);",
    "    F(i, 1, n - 1) {",
    "      Z s = 0;",
    "      for (auto &[k, v] : d) {",
    "        if (k > i)",
    "          break;",
    "        s += v * g[i - k];",
    "      }",
    "      g[i] = s * invnum(i);",
    "    }",
    "    return g;",
    "  }",
    "  static vc<Z> exp_dense(const vc<Z> &f, int n) {",
    "    vc<Z> g{Z(1)};",
    "    for (int m = 1; m < n; m <<= 1) {",
    "      int len = min(m << 1, n);",
    "      vc<Z> lg = ln(g, len);",
    "      vc<Z> h(len);",
    "      F(i, 0, len - 1) h[i] = (i < (int)f.size() ? f[i] : Z(0)) - lg[i];",
    "      h[0] += Z(1);",
    "      vc<Z> h2(len - m);",
    "      F(i, 0, len - m - 1) h2[i] = h[i + m];",
    "      vc<Z> t = conv(g, h2);",
    "      g.resize(len);",
    "      F(i, m, len - 1) g[i] = i - m < (int)t.size() ? t[i - m] : Z(0);",
    "    }",
    "    return g;",
    "  }",
    "  static Z sqrt_mod(Z a) {",
    "    if (!a.val())",
    "      return Z(0);",
    "    if (qpow(a, (MOD - 1) >> 1) != Z(1))",
    "      return Z(0);",
    "    if (MOD % 4 == 3)",
    "      return qpow(a, (MOD + 1) >> 2);",
    "    Z b = 2;",
    "    while (qpow(b, (MOD - 1) >> 1) == Z(1))",
    "      b += Z(1);",
    "    int s = 0;",
    "    ll t = MOD - 1;",
    "    while (!(t & 1))",
    "      t >>= 1, s++;",
    "    Z ia = a.inv(), c = qpow(b, t), x = qpow(a, (t + 1) >> 1);",
    "    int m = s;",
    "    while (x * x != a) {",
    "      Z y = x * x * ia;",
    "      int k = 0;",
    "      for (Z z = y; z != Z(1); z *= z)",
    "        k++;",
    "      Z w = qpow(c, 1 << (m - k - 1));",
    "      x *= w, c = w * w, m = k;",
    "    }",
    "    return x;",
    "  }",
    "  static vc<Z> sqrt(const vc<Z> &f, int n) {",
    "    if (n <= 0)",
    "      return {};",
    "    int m = f.size(), t = 0;",
    "    while (t < m && !f[t].val())",
    "      t++;",
    "    if (t == m)",
    "      return vc<Z>(n);",
    "    if (t & 1)",
    "      return {};",
    "    if ((t >> 1) >= n)",
    "      return vc<Z>(n);",
    "    Z y = f[t], x = sqrt_mod(y);",
    "    if (x * x != y)",
    "      return {};",
    "    Z iy = y.inv();",
    "    vc<Z> g(f.begin() + t, f.end());",
    "    F(i, 0, (int)g.size() - 1) g[i] *= iy;",
    "    g = sqrt_dense(g, n - (t >> 1));",
    "    F(i, 0, (int)g.size() - 1) g[i] *= x;",
    "    vc<Z> res(n);",
    "    F(i, 0, (int)g.size() - 1) res[i + (t >> 1)] = g[i];",
    "    return res;",
    "  }",
    "  static vc<Z> sqrt_dense(const vc<Z> &f, int n) {",
    "    assert(f[0].val() == 1);",
    "    Z i2 = Z(2).inv();",
    "    vc<Z> g{Z(1)};",
    "    for (int m = 1; m < n; m <<= 1) {",
    "      int len = min(m << 1, n);",
    "      vc<Z> t(f.begin(), f.begin() + min((int)f.size(), len));",
    "      g.resize(len);",
    "      vc<Z> h = conv(t, inv(g, len));",
    "      h.resize(len);",
    "      F(i, 0, len - 1) h[i] = (h[i] + g[i]) * i2;",
    "      g = h;",
    "    }",
    "    g.resize(max(n, 0));",
    "    return g;",
    "  }",
    "  static vc<Z> pow(const vc<Z> &f, ll k, int n) {",
    "    if (n <= 0)",
    "      return {};",
    "    int m = f.size(), t = 0;",
    "    while (t < m && !f[t].val())",
    "      t++;",
    "    if (t == m || (i128)t * k >= n)",
    "      return vc<Z>(n);",
    "    int len = n - (int)(t * k);",
    "    vc<Z> g(f.begin() + t, f.end());",
    "    Z c = g[0], ic = c.inv();",
    "    F(i, 0, (int)g.size() - 1) g[i] *= ic;",
    "    g = pow1(g, Z(k), len);",
    "    Z ck = qpow(c, k);",
    "    F(i, 0, len - 1) g[i] *= ck;",
    "    vc<Z> res(n);",
    "    F(i, 0, len - 1) res[i + (int)(t * k)] = g[i];",
    "    return res;",
    "  }",
    "  static vc<Z> pow1(const vc<Z> &f, Z K, int n) {",
    "    if (n <= 0)",
    "      return {};",
    "    if (sparse(f, n, 800)) {",
    "      vc<pair<int, Z>> d;",
    "      F(i, 1, (int)f.size() - 1) if (f[i].val()) d.push_back({i, f[i]});",
    "      vc<Z> g(n);",
    "      g[0] = Z(1);",
    "      F(i, 0, n - 2) {",
    "        Z s = 0;",
    "        for (auto &[k, v] : d) {",
    "          if (k > i + 1)",
    "            break;",
    "          s += v * g[i + 1 - k] * (K * k - (i + 1 - k));",
    "        }",
    "        g[i + 1] = s * invnum(i + 1);",
    "      }",
    "      return g;",
    "    }",
    "    vc<Z> g = ln(f, n);",
    "    F(i, 0, n - 1) g[i] *= K;",
    "    return exp(g, n);",
    "  }",
    "  static vc<Z> div(const vc<Z> &f, const vc<Z> &g) {",
    "    int n = f.size(), m = g.size();",
    "    if (n < m || !m)",
    "      return {};",
    "    assert(g.back().val());",
    "    vc<Z> a(f.rbegin(), f.rend()), b(g.rbegin(), g.rend());",
    "    int k = n - m + 1;",
    "    a.resize(k);",
    "    vc<Z> q = conv(a, inv(b, k));",
    "    q.resize(k);",
    "    reverse(All(q));",
    "    return q;",
    "  }",
    "  static vc<Z> mod(const vc<Z> &f, const vc<Z> &g) {",
    "    int n = f.size(), m = g.size();",
    "    if (n < m)",
    "      return f;",
    "    vc<Z> q = div(f, g), t = conv(q, g), h = f;",
    "    F(i, 0, (int)t.size() - 1) h[i] -= t[i];",
    "    h.resize(m - 1);",
    "    return h;",
    "  }",
    "  static Z coef(vc<Z> P, vc<Z> Q, ll n) {",
    "    assert(!Q.empty() && Q[0].val());",
    "    Z iq = Q[0].inv();",
    "    F(i, 0, (int)P.size() - 1) P[i] *= iq;",
    "    F(i, 0, (int)Q.size() - 1) Q[i] *= iq;",
    "    Z base = 0;",
    "    if ((int)P.size() >= (int)Q.size()) {",
    "      vc<Z> d = div(P, Q);",
    "      base = n < (ll)d.size() ? d[(int)n] : Z(0);",
    "      P = mod(P, Q);",
    "    }",
    "    P.resize(Q.size() - 1);",
    "    while (n) {",
    "      if ((ll)P.size() - 1 > n) {",
    "        P.resize(n + 1);",
    "        if ((ll)Q.size() > n + 2)",
    "          Q.resize(n + 2);",
    "      }",
    "      if (P.empty())",
    "        return base;",
    "      vc<Z> Qm(Q.size());",
    "      F(i, 0, (int)Q.size() - 1) Qm[i] = (i & 1) ? -Q[i] : Q[i];",
    "      vc<Z> S = conv(P, Qm), T = conv(Q, Qm);",
    "      P.clear(), Q.clear();",
    "      for (int i = n & 1; i < (int)S.size(); i += 2) P.push_back(S[i]);",
    "      for (int i = 0; i < (int)T.size(); i += 2) Q.push_back(T[i]);",
    "      n >>= 1;",
    "    }",
    "    return base + P[0] * Q[0].inv();",
    "  }",
    "  static Z nth(const vc<Z> &a, const vc<Z> &c, ll n) {",
    "    int k = c.size();",
    "    assert(k);",
    "    vc<Z> q(k + 1);",
    "    q[0] = 1;",
    "    F(i, 0, k - 1) q[i + 1] = -c[i];",
    "    vc<Z> p = conv(a, q);",
    "    p.resize(k);",
    "    return coef(p, q, n);",
    "  }",
    "  static vc<Z> shift(vc<Z> f, Z c) {",
    "    int n = f.size();",
    "    if (!n || !c.val())",
    "      return f;",
    "    vc<Z> fac(n), ifac(n), a(n), b(n);",
    "    fac[0] = 1;",
    "    F(i, 1, n - 1) fac[i] = fac[i - 1] * i;",
    "    ifac[n - 1] = fac[n - 1].inv();",
    "    DF(i, n - 1, 1) ifac[i - 1] = ifac[i] * i;",
    "    Z pw = 1;",
    "    F(i, 0, n - 1) {",
    "      a[n - 1 - i] = f[i] * fac[i];",
    "      b[i] = pw * ifac[i];",
    "      pw *= c;",
    "    }",
    "    vc<Z> h = conv(a, b), g(n);",
    "    F(i, 0, n - 1) g[i] = h[n - 1 - i] * ifac[i];",
    "    return g;",
    "  }",
    "  static Z iota(const vc<Z> &y, ll c) {",
    "    int n = y.size();",
    "    assert(n);",
    "    if (c >= 0 && c < n)",
    "      return y[(int)c];",
    "    vc<Z> l(n + 1), r(n + 1), fac(n + 1), ifac(n + 1);",
    "    l[0] = 1, r[n] = 1;",
    "    F(i, 0, n - 1) l[i + 1] = l[i] * (Z(c) - i);",
    "    DF(i, n - 1, 0) r[i] = r[i + 1] * (Z(c) - i);",
    "    fac[0] = 1;",
    "    F(i, 1, n) fac[i] = fac[i - 1] * i;",
    "    ifac[n] = fac[n].inv();",
    "    DF(i, n, 1) ifac[i - 1] = ifac[i] * i;",
    "    Z ans = 0;",
    "    F(i, 0, n - 1) {",
    "      Z t = y[i] * l[i] * r[i + 1] * ifac[i] * ifac[n - 1 - i];",
    "      if ((n - 1 - i) & 1)",
    "        ans -= t;",
    "      else",
    "        ans += t;",
    "    }",
    "    return ans;",
    "  }",
    "};",
    "template <int MOD> struct MultiEval {",
    "  using Z = Mint<MOD>;",
    "  using P = Poly<MOD>;",
    "  vc<vc<Z>> t;",
    "  vc<Z> res;",
    "  void build(int p, int l, int r, const vc<Z> &x) {",
    "    if (l == r) {",
    "      t[p] = {-x[l], Z(1)};",
    "      return;",
    "    }",
    "    int mid = l + r >> 1;",
    "    build(p << 1, l, mid, x), build(p << 1 | 1, mid + 1, r, x);",
    "    t[p] = P::conv(t[p << 1], t[p << 1 | 1]);",
    "  }",
    "  void solve(int p, int l, int r, const vc<Z> &f) {",
    "    vc<Z> g = P::mod(f, t[p]);",
    "    if (l == r) {",
    "      res[l] = g.empty() ? Z(0) : g[0];",
    "      return;",
    "    }",
    "    int mid = l + r >> 1;",
    "    solve(p << 1, l, mid, g), solve(p << 1 | 1, mid + 1, r, g);",
    "  }",
    "  vc<Z> merge(int p, int l, int r, const vc<Z> &c) {",
    "    if (l == r)",
    "      return {c[l]};",
    "    int mid = l + r >> 1;",
    "    vc<Z> a = merge(p << 1, l, mid, c), b = merge(p << 1 | 1, mid + 1, r, c);",
    "    vc<Z> u = P::conv(a, t[p << 1 | 1]), v = P::conv(b, t[p << 1]);",
    "    F(i, 0, (int)v.size() - 1) u[i] += v[i];",
    "    return u;",
    "  }",
    "  vc<Z> eval(const vc<Z> &f, const vc<Z> &x) {",
    "    int n = x.size();",
    "    if (!n)",
    "      return {};",
    "    t.assign(n << 2, {}), res.assign(n, 0);",
    "    build(1, 0, n - 1, x);",
    "    solve(1, 0, n - 1, f);",
    "    return res;",
    "  }",
    "  vc<Z> interp(const vc<Z> &x, const vc<Z> &y) {",
    "    int n = x.size();",
    "    assert((int)y.size() == n);",
    "    if (!n)",
    "      return {};",
    "    t.assign(n << 2, {}), res.assign(n, 0);",
    "    build(1, 0, n - 1, x);",
    "    solve(1, 0, n - 1, P::der(t[1]));",
    "    vc<Z> c(n);",
    "    F(i, 0, n - 1) c[i] = y[i] * res[i].inv();",
    "    return merge(1, 0, n - 1, c);",
    "  }",
    "};",
    "template <int MOD> struct MTT {",
    "  static constexpr int M1 = 998244353, M2 = 1004535809, M3 = 469762049;",
    "  template <typename T> static vc<T> wrap(const vc<int> &a) {",
    "    vc<T> b(a.size());",
    "    F(i, 0, (int)a.size() - 1) b[i] = T(a[i]);",
    "    return b;",
    "  }",
    "  template <typename T> static vc<int> unwrap(const vc<T> &a) {",
    "    vc<int> b(a.size());",
    "    F(i, 0, (int)a.size() - 1) b[i] = a[i].val();",
    "    return b;",
    "  }",
    "  static vc<int> mul(const vc<int> &a, const vc<int> &b) {",
    "    int n = a.size(), m = b.size();",
    "    if (!n || !m)",
