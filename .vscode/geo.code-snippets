    "    llb th = 2 * acosl(max((llb)-1, min((llb)1, uu)));",
    "    llb cr = llb(u.cross(v));",
    "    if (cr < 0)",
    "      th = 2 * PI - th;",
    "    return r2 * th / 2 + cr / 2;",
    "  };",
