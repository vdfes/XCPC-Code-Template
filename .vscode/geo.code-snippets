    "      Point<llb> b = c[i].o + Point<llb>(cosl(t2), sinl(t2)) * c[i].r;",
    "      ans += (c[i].r * c[i].r * (t2 - t1) - llb((a - c[i].o).cross(b - c[i].o))) / 2;",
    "    }",
    "  }",
    "  return ans;",
    "}",
    "template <typename T> struct HPI {",
    "  vc<Line<T>> l;",
    "  void add(Point<T> a, Point<T> b) { l.push_back(Line<T>(a, b)); }",
    "  void add(const Line<T> &x) { l.push_back(x); }",
    "  static bool onleft(const Line<T> &a, const Point<T> &p) { return sgn(a.a.cross(a.b, p)) >= 0; }",
    "  static Point<T> inter(const Line<T> &a, const Line<T> &b) { return line_inter(a.a, a.b, b.a, b.b); }",
    "  vc<Point<T>> solve() {",
    "    sort(All(l), [](const Line<T> &a, const Line<T> &b) {",
    "      llb x = a.dir().ang(), y = b.dir().ang();",
    "      if (!eq(x, y))",
    "        return x < y;",
    "      return sgn(a.a.cross(a.b, b.a)) > 0;",
    "    });",
    "    vc<Line<T>> q;",
    "    for (auto &x : l) {",
    "      if (!q.empty() && sgn(q.back().dir().cross(x.dir())) == 0) {",
    "        if (!onleft(q.back(), x.a))",
    "          continue;",
    "        q.pop_back();",
    "      }",
    "      q.push_back(x);",
    "    }",
    "    int n = q.size();",
    "    if (n < 3)",
    "      return {};",
    "    vc<int> dq(n);",
    "    int h = 0, t = 0;",
    "    dq[0] = 0;",
    "    F(i, 1, n - 1) {",
    "      while (t > h && !onleft(q[i], inter(q[dq[t - 1]], q[dq[t]])))",
    "        t--;",
    "      while (t > h && !onleft(q[i], inter(q[dq[h + 1]], q[dq[h]])))",
    "        h++;",
    "      dq[++t] = i;",
    "    }",
    "    while (t > h + 1 && !onleft(q[dq[h]], inter(q[dq[t - 1]], q[dq[t]])))",
    "      t--;",
    "    while (t > h + 1 && !onleft(q[dq[t]], inter(q[dq[h + 1]], q[dq[h]])))",
    "      h++;",
    "    if (t - h < 2)",
    "      return {};",
    "    vc<Point<T>> res;",
    "    F(i, h, t) res.push_back(inter(q[dq[i]], q[dq[i == t ? h : i + 1]]));",
    "    return res;",
    "  }",
    "};",
    "template <typename T> struct HPIi {",
    "  struct Ln {",
    "    Point<T> a, d;",
    "  };",
    "  struct F {",
    "    i128 X = 0, Y = 0, den = 1;",
    "  };",
    "  vc<Ln> l;",
    "  void add(Point<T> a, Point<T> b) { l.push_back({a, b - a}); }",
    "  static int same_dir(const Ln &x, const Ln &y) {",
    "    i128 c = i128(x.d.x) * y.d.y - i128(x.d.y) * y.d.x;",
    "    i128 t = i128(x.d.x) * y.d.x + i128(x.d.y) * y.d.y;",
    "    return c == 0 && t > 0;",
    "  }",
    "  static bool leftof(const Ln &x, const F &p) {",
    "    i128 A = p.X - i128(x.a.x) * p.den, B = p.Y - i128(x.a.y) * p.den;",
    "    i128 s = A * x.d.y - B * x.d.x;",
    "    return s <= 0;",
    "  }",
    "  static F inter(const Ln &x, const Ln &y) {",
    "    i128 den = i128(x.d.x) * y.d.y - i128(x.d.y) * y.d.x;",
    "    i128 t = (i128(y.a.x) - x.a.x) * y.d.y - (i128(y.a.y) - x.a.y) * y.d.x;",
    "    if (den < 0)",
    "      den = -den, t = -t;",
    "    F f;",
    "    f.den = den;",
    "    f.X = i128(x.a.x) * den + t * x.d.x;",
    "    f.Y = i128(x.a.y) * den + t * x.d.y;",
    "    return f;",
    "  }",
    "  vc<Point<llb>> solve() {",
    "    int n = l.size();",
    "    if (!n)",
    "      return {};",
    "    sort(All(l), [](const Ln &x, const Ln &y) {",
    "      int hx = (x.d.y < 0 || (x.d.y == 0 && x.d.x < 0)), hy = (y.d.y < 0 || (y.d.y == 0 && y.d.x < 0));",
    "      if (hx != hy)",
    "        return hx < hy;",
    "      i128 c = i128(x.d.x) * y.d.y - i128(x.d.y) * y.d.x;",
    "      return c > 0;",
    "    });",
    "    vc<Ln> q;",
    "    for (auto &x : l) {",
    "      if (!q.empty() && same_dir(q.back(), x)) {",
    "        i128 s = (i128(x.a.x) - q.back().a.x) * q.back().d.y - (i128(x.a.y) - q.back().a.y) * q.back().d.x;",
    "        if (s <= 0)",
    "          continue;",
    "        q.pop_back();",
    "      }",
    "      q.push_back(x);",
    "    }",
    "    int k = q.size();",
    "    if (k < 3)",
    "      return {};",
    "    vc<int> dq(k);",
    "    int h = 0, t = 0;",
    "    dq[0] = 0;",
    "    F(i, 1, k - 1) {",
    "      while (t > h && !leftof(q[i], inter(q[dq[t - 1]], q[dq[t]])))",
    "        t--;",
    "      while (t > h && !leftof(q[i], inter(q[dq[h]], q[dq[h + 1]])))",
    "        h++;",
    "      dq[++t] = i;",
    "    }",
    "    while (t > h + 1 && !leftof(q[dq[h]], inter(q[dq[t - 1]], q[dq[t]])))",
    "      t--;",
    "    while (t > h + 1 && !leftof(q[dq[t]], inter(q[dq[h]], q[dq[h + 1]])))",
    "      h++;",
    "    if (t - h < 2)",
    "      return {};",
    "    vc<Point<llb>> res;",
    "    F(i, h, t) {",
    "      F f = inter(q[dq[i]], q[dq[i == t ? h : i + 1]]);",
    "      if (!f.den)",
    "        return {};",
    "      res.push_back(Point<llb>(llb(f.X) / llb(f.den), llb(f.Y) / llb(f.den)));",
    "    }",
    "    if (res.size() < 3)",
    "      return {};",
    "    llb s = 0;",
    "    F(i, 0, (int)res.size() - 1) s += res[i].cross(res[(i + 1) % res.size()]);",
    "    if (fabsl(s) < 1e-12L)",
    "      return {};",
    "    return res;",
    "  }",
    "};",
