    "template <typename T> llb circ_union(vc<Circle<T>> c) {",
    "  int n = c.size();",
    "  llb ans = 0;",
    "  F(i, 0, n - 1) {",
    "    if (c[i].r <= eps)",
    "      continue;",
    "    bool covered = false;",
    "    F(j, 0, n - 1) {",
    "      if (i == j || covered)",
    "        continue;",
    "      llb d = c[i].o.dist(c[j].o);",
    "      if (d + c[i].r <= c[j].r + eps)",
    "        covered = true;",
    "    }",
    "    if (covered)",
    "      continue;",
    "    vc<llb> ev;",
    "    F(j, 0, n - 1) {",
    "      if (i == j)",
    "        continue;",
    "      llb d = c[i].o.dist(c[j].o);",
    "      if (d >= c[i].r + c[j].r - eps || d <= 1e-18L || d + c[j].r <= c[i].r + eps)",
    "        continue;",
    "      llb al = acosl(max((llb)-1, min((llb)1, (d * d + c[i].r * c[i].r - c[j].r * c[j].r) / (2 * d * c[i].r))));",
    "      llb th = (c[j].o - c[i].o).ang();",
    "      ev.push_back(th - al), ev.push_back(th + al);",
    "    }",
    "    if (ev.empty()) {",
