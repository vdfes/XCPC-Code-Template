    "    vc<Point<T>> its = circ_line(c, p, q);",
    "    Point<T> best = q;",
    "    for (auto &x : its) {",
    "      if ((x - p).cdist(Point<T>()) > (q - p).cdist(Point<T>())) {",
    "        if (best == q || (x - p).cdist(Point<T>()) < (best - p).cdist(Point<T>()))",
    "          best = x;",
    "      }",
    "    }",
    "    return best;",
    "  };",
