    "}",
    "template <typename T> vc<Point<T>> minkowski(vc<Point<T>> a, vc<Point<T>> b) {",
    "  int n = a.size(), m = b.size();",
    "  if (!n || !m)",
    "    return {};",
    "  if (n < 3 || m < 3) {",
    "    vc<Point<T>> all;",
    "    F(i, 0, n - 1) F(j, 0, m - 1) all.push_back(a[i] + b[j]);",
    "    return convex(all);",
    "  }",
    "  auto lift = [](const vc<Point<T>> &p) {",
    "    vc<Point<T>> q = p;",
    "    int k = 0;",
    "    F(i, 1, (int)q.size() - 1) if (cmp_xy(q[i], q[k])) k = i;",
    "    rotate(q.begin(), q.begin() + k, q.end());",
    "    return q;",
    "  };",
    "  a = lift(a), b = lift(b);",
    "  vc<Point<T>> e1(n), e2(m);",
    "  F(i, 0, n - 1) e1[i] = a[(i + 1) % n] - a[i];",
    "  F(i, 0, m - 1) e2[i] = b[(i + 1) % m] - b[i];",
    "  auto half = [](const Point<T> &v) { return (v.y < 0 || (v.y == 0 && v.x < 0)) ? 1 : 0; };",
    "  auto ahead = [&](const Point<T> &u, const Point<T> &v) {",
    "    int hu = half(u), hv = half(v);",
    "    if (hu != hv)",
    "      return hu < hv;",
    "    int c = sgn(u.cross(v));",
    "    if (c)",
    "      return c > 0;",
    "    return u.cdist(Point<T>()) > v.cdist(Point<T>());",
    "  };",
    "  vc<Point<T>> edge;",
    "  int i = 0, j = 0;",
    "  while (i < n || j < m) {",
    "    if (i < n && j < m) {",
    "      if (ahead(e1[i], e2[j]))",
    "        edge.push_back(e1[i++]);",
    "      else",
    "        edge.push_back(e2[j++]);",
    "    } else if (i < n)",
    "      edge.push_back(e1[i++]);",
    "    else",
    "      edge.push_back(e2[j++]);",
    "  }",
    "  vc<Point<T>> res;",
    "  Point<T> cur = a[0] + b[0];",
    "  res.push_back(cur);",
    "  for (auto &e : edge)",
    "    cur = cur + e, res.push_back(cur);",
    "  res.pop_back();",
    "  vc<Point<T>> r2;",
    "  int k2 = res.size();",
    "  F(i, 0, k2 - 1) {",
    "    if (sgn(res[(i + k2 - 1) % k2].cross(res[i], res[(i + 1) % k2])) != 0)",
    "      r2.push_back(res[i]);",
    "  }",
    "  return convex(r2);",
    "}",
    "template <typename T> llb closest(vc<Point<T>> p) {",
    "  int n = p.size();",
    "  if (n < 2)",
    "    return 0;",
    "  sort(All(p), cmp_x<T>);",
    "  vc<Point<T>> buf(n);",
    "  auto rec = [&](auto &&self, int l, int r) -> llb {",
    "    if (r - l <= 16) {",
    "      llb ans = 1e100L;",
    "      F(i, l, r) F(j, i + 1, r) ans = min(ans, p[i].dist(p[j]));",
    "      sort(p.begin() + l, p.begin() + r + 1, cmp_xy<T>);",
    "      return ans;",
    "    }",
    "    int mid = l + r >> 1;",
    "    T mx = p[mid].x;",
    "    llb d = min(self(self, l, mid), self(self, mid + 1, r));",
    "    int i = l, j = mid + 1, k = l;",
    "    while (i <= mid && j <= r) {",
    "      if (p[i].y < p[j].y)",
    "        buf[k++] = p[i++];",
    "      else",
    "        buf[k++] = p[j++];",
    "    }",
    "    while (i <= mid)",
    "      buf[k++] = p[i++];",
    "    while (j <= r)",
