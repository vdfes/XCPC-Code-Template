    "    return 0;",
    "  auto inside = [&](const Point<T> &p) { return (p - c.o).cdist(Point<T>()) <= r2; };",
    "  auto arc = [&](Point<T> p, Point<T> q) {",
    "    Point<T> u = p - c.o, v = q - c.o;",
    "    llb lu = u.len(), lv = v.len();",
    "    if (lu == 0 || lv == 0)",
    "      return (llb)0;",
