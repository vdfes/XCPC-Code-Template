    "        auto mk = [&](llb X, llb Y) {",
    "          return Point<T>(llb(c[i].x) + (X * llb(v.x) + Y * llb(N.x)) / d2,",
    "                          llb(c[i].y) + (X * llb(v.y) + Y * llb(N.y)) / d2);",
    "        };",
    "        vc<Point<T>> r = {mk(a, y1), mk(b, y1), mk(b, y2), mk(a, y2)};",
    "        Point<T> o = (r[0] + r[1] + r[2] + r[3]).divi(4);",
    "        F(p, 2, 3) {",
    "          Point<T> key = r[p];",
    "          int q = p;",
    "          while (q > 0 && angle_cmp<T>(o)(key, r[q - 1]))",
    "            r[q] = r[q - 1], q--;",
    "          r[q] = key;",
    "        }",
    "        *out = r;",
    "      }",
    "    }",
    "  }",
    "  return best;",
    "}",
