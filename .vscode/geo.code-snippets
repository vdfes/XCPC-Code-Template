    "template <typename T> bool cmp_xy(const Point<T> &a, const Point<T> &b) { return a.x != b.x ? a.x < b.x : a.y < b.y; }",
    "template <typename T> bool cmp_x(const Point<T> &a, const Point<T> &b) { return a.x < b.x; }",
    "template <typename T> struct angle_cmp {",
    "  Point<T> base;",
    "  explicit angle_cmp(Point<T> b = Point<T>()) : base(b) {}",
    "  int half(const Point<T> &p) const {",
    "    Point<T> q = p - base;",
    "    if (q.y > 0)",
    "      return 0;",
    "    if (q.y == 0 && q.x >= 0)",
    "      return 0;",
    "    return 1;",
    "  }",
    "  bool operator()(const Point<T> &a, const Point<T> &b) const {",
    "    int ha = half(a), hb = half(b);",
    "    if (ha != hb)",
    "      return ha < hb;",
    "    auto c = cross(a - base, b - base);",
    "    int s = sgn(c);",
    "    if (s != 0)",
    "      return s > 0;",
    "    return cdist(a, base) < cdist(b, base);",
    "  }",
    "};",
    "template <typename T> void angle_sort(vc<Point<T>> &p, Point<T> base = Point<T>()) { sort(All(p), angle_cmp<T>{base}); }",
    "template <typename T> vc<Point<T>> unique_pts(vc<Point<T>> p) {",
    "  sort(All(p), cmp_xy<T>);",
    "  p.erase(unique(All(p)), p.end());",
    "  return p;",
    "}",
    "template <typename T, typename U> int side(const Point<T> &a, const Point<T> &b, const Point<U> &p) {",
    "  return sgn(a.cross(b, p));",
    "}",
    "template <typename T> bool left(const Point<T> &a, const Point<T> &b, const Point<T> &p) { return side(a, b, p) > 0; }",
    "template <typename T> bool parallel(const Point<T> &a, const Point<T> &b, const Point<T> &c, const Point<T> &d) {",
    "  return sgn((b - a).cross(d - c)) == 0;",
    "}",
    "template <typename T> bool same_dir(const Point<T> &a, const Point<T> &b) {",
    "  return sgn(a.cross(b)) == 0 && a.dot(b) > 0;",
    "}",
    "template <typename T, typename U> bool on_line(const Point<T> &a, const Point<T> &b, const Point<U> &p) {",
    "  return sgn(a.cross(b, p)) == 0;",
    "}",
    "template <typename T, typename U> bool on_seg(const Point<T> &a, const Point<T> &b, const Point<U> &p) {",
    "  return sgn(a.cross(b, p)) == 0 && le(min(a.x, b.x), p.x) && le(p.x, max(a.x, b.x)) && le(min(a.y, b.y), p.y) &&",
    "         le(p.y, max(a.y, b.y));",
    "}",
    "template <typename T> Point<T> proj(const Point<T> &a, const Point<T> &b, const Point<T> &p) {",
    "  Point<T> d = b - a;",
    "  return a + d * (llb(d.dot(p - a)) / llb(d.dot(d)));",
    "}",
    "template <typename T> Point<T> foot(const Point<T> &a, const Point<T> &b, const Point<T> &p) { return proj(a, b, p); }",
    "template <typename T> Point<T> refl(const Point<T> &a, const Point<T> &b, const Point<T> &p) {",
    "  return proj(a, b, p) * 2 - p;",
    "}",
    "template <typename T> llb line_dist(const Point<T> &a, const Point<T> &b, const Point<T> &p) {",
    "  return llb(a.cross(b, p) < 0 ? -a.cross(b, p) : a.cross(b, p)) / (b - a).len();",
    "}",
    "template <typename T> llb seg_dist(const Point<T> &a, const Point<T> &b, const Point<T> &p) {",
    "  Point<T> d = b - a;",
    "  llb t = llb(d.dot(p - a)) / llb(d.dot(d));",
    "  if (t < 0)",
    "    return p.dist(a);",
    "  if (t > 1)",
    "    return p.dist(b);",
    "  return line_dist(a, b, p);",
    "}",
    "template <typename T> Point<T> line_inter(const Point<T> &a, const Point<T> &b, const Point<T> &c, const Point<T> &d) {",
    "  Point<T> d1 = b - a, d2 = d - c;",
    "  T den = d1.cross(d2);",
    "  if (sgn(den) == 0)",
    "    return Point<T>();",
    "  return a + d1 * (llb((c - a).cross(d2)) / llb(den));",
    "}",
    "template <typename T> bool seg_inter(const Point<T> &a, const Point<T> &b, const Point<T> &c, const Point<T> &d) {",
    "  int c1 = side(a, b, c), c2 = side(a, b, d), c3 = side(c, d, a), c4 = side(c, d, b);",
    "  if (c1 * c2 < 0 && c3 * c4 < 0)",
    "    return true;",
    "  if (!c1 && on_seg(a, b, c))",
    "    return true;",
    "  if (!c2 && on_seg(a, b, d))",
    "    return true;",
    "  if (!c3 && on_seg(c, d, a))",
    "    return true;",
    "  if (!c4 && on_seg(c, d, b))",
    "    return true;",
    "  return false;",
    "}",
    "template <typename T>",
    "Point<T> seg_inter_pt(const Point<T> &a, const Point<T> &b, const Point<T> &c, const Point<T> &d) {",
    "  Point<T> d1 = b - a, d2 = d - c;",
    "  auto den = d1.cross(d2);",
    "  if (sgn(den) != 0)",
    "    return a + d1 * (llb((c - a).cross(d2)) / llb(den));",
    "  return on_seg(a, b, c) ? c : d;",
    "}",
    "template <typename T> llb seg_dist(const Point<T> &a, const Point<T> &b, const Point<T> &c, const Point<T> &d) {",
    "  if (seg_inter(a, b, c, d))",
    "    return 0;",
    "  llb ans = seg_dist(a, b, c);",
    "  ans = min(ans, seg_dist(a, b, d));",
    "  ans = min(ans, seg_dist(c, d, a));",
    "  ans = min(ans, seg_dist(c, d, b));",
    "  return ans;",
    "}",
    "template <typename T> bool in_angle(const Point<T> &o, const Point<T> &a, const Point<T> &b, const Point<T> &p) {",
    "  return sgn((a - o).cross(p - o)) >= 0 && sgn((p - o).cross(b - o)) >= 0;",
    "}",
    "template <typename T> typename Point<T>::I tri_area2(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  return (b - a).cross(c - a);",
    "}",
    "template <typename T> llb tri_area(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  auto s = tri_area2(a, b, c);",
    "  return llb(s < 0 ? -s : s) / 2;",
    "}",
    "template <typename T> llb tri_height(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  return 2 * tri_area(a, b, c) / b.dist(c);",
    "}",
    "template <typename T> Point<llb> triangle_cc(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  llb ax = llb(a.x), ay = llb(a.y), bx = llb(b.x), by = llb(b.y), cx = llb(c.x), cy = llb(c.y);",
    "  llb d = 2 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));",
    "  if (fabsl(d) < eps)",
    "    return Point<llb>();",
    "  llb a2 = ax * ax + ay * ay, b2 = bx * bx + by * by, c2 = cx * cx + cy * cy;",
    "  llb ux = a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by);",
    "  llb uy = a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax);",
    "  return Point<llb>(ux / d, uy / d);",
    "}",
    "template <typename T> struct Circle {",
    "  Point<T> o;",
    "  llb r;",
    "  Circle(Point<T> o = Point<T>(), llb r = 0) : o(o), r(r) {}",
    "  bool operator==(const Circle &c) const { return o == c.o && eq(r, c.r); }",
    "  bool operator!=(const Circle &c) const { return !(*this == c); }",
    "  template <typename U> bool contains(const Point<U> &p) const { return le(p.dist(o), r); }",
    "};",
    "template <typename T> Circle<llb> triangle_oc(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  Point<llb> o = triangle_cc(a, b, c);",
    "  return Circle<llb>(o, o.dist(a));",
    "}",
    "template <typename T> Point<llb> triangle_ic(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  llb x = b.dist(c), y = a.dist(c), z = a.dist(b), s = x + y + z;",
    "  return Point<llb>((llb(a.x) * x + llb(b.x) * y + llb(c.x) * z) / s, (llb(a.y) * x + llb(b.y) * y + llb(c.y) * z) / s);",
    "}",
    "template <typename T> Circle<llb> triangle_occer(const Point<T> &a, const Point<T> &b, const Point<T> &c) {",
    "  Point<llb> o = triangle_ic(a, b, c);",
    "  return Circle<llb>(o, tri_area(a, b, c) * 2 / (a.dist(b) + b.dist(c) + c.dist(a)));",
    "}",
    "template <typename T> bool in_triangle(const Point<T> &a, const Point<T> &b, const Point<T> &c, const Point<T> &p) {",
    "  int c1 = side(a, b, p), c2 = side(b, c, p), c3 = side(c, a, p);",
    "  bool pos = c1 > 0 || c2 > 0 || c3 > 0, neg = c1 < 0 || c2 < 0 || c3 < 0;",
    "  return !(pos && neg);",
    "}",
    "template <typename T> llb max_triangle_area(const vc<Point<T>> &p) {",
    "  int n = p.size();",
    "  if (n < 3)",
    "    return 0;",
    "  llb ans = 0;",
    "  auto A2 = [&](int i, int j, int k) { return llb(tri_area2(p[i], p[j], p[k])); };",
    "  F(i, 0, n - 1) {",
    "    int k = (i + 2) % n;",
    "    for (int j = (i + 1) % n; j != i; j = (j + 1) % n) {",
    "      int kj = (j + 1) % n;",
    "      if (k == j || k == i)",
    "        k = (k + 1) % n;",
    "      while (kj != i && sgn(A2(i, j, kj) - A2(i, j, k)) >= 0)",
    "        k = kj, kj = (kj + 1) % n;",
    "      ckmax(ans, A2(i, j, k));",
    "    }",
    "  }",
    "  return ans / 2;",
    "}",
    "template <typename T> typename Point<T>::I area2(const vc<Point<T>> &p) {",
    "  int n = p.size();",
    "  typename Point<T>::I s = 0;",
    "  F(i, 0, n - 1) s += p[i].cross(p[(i + 1) % n]);",
    "  return s;",
    "}",
    "template <typename T> llb area(const vc<Point<T>> &p) {",
    "  auto s = area2(p);",
    "  return llb(s < 0 ? -s : s) / 2;",
    "}",
    "template <typename T> llb perimeter(const vc<Point<T>> &p) {",
    "  int n = p.size();",
    "  llb s = 0;",
    "  F(i, 0, n - 1) s += p[i].dist(p[(i + 1) % n]);",
    "  return s;",
    "}",
    "template <typename T> int orient(const vc<Point<T>> &p) { return sgn(area2(p)); }",
    "template <typename T> bool is_convex(const vc<Point<T>> &p) {",
    "  int n = p.size();",
    "  if (n < 3)",
    "    return false;",
    "  int pos = 0, neg = 0;",
    "  F(i, 0, n - 1) {",
    "    int c = sgn(tri_area2(p[i], p[(i + 1) % n], p[(i + 2) % n]));",
    "    if (c > 0)",
    "      pos = 1;",
    "    if (c < 0)",
    "      neg = 1;",
    "    if (pos && neg)",
    "      return false;",
    "  }",
    "  return true;",
    "}",
    "template <typename T, typename U> int is_in_poly(const Point<U> &q, const vc<Point<T>> &p) {",
    "  int n = p.size();",
    "  F(i, 0, n - 1) {",
    "    if (on_seg(p[i], p[(i + 1) % n], q))",
    "      return 0;",
    "  }",
    "  bool in = false;",
    "  F(i, 0, n - 1) {",
    "    Point<T> a = p[i], b = p[(i + 1) % n];",
    "    if ((b.y > q.y) != (a.y > q.y)) {",
    "      auto cr = (b - a).cross(q - a);",
    "      if ((sgn(cr) > 0) == (b.y > a.y))",
    "        in = !in;",
    "    }",
    "  }",
    "  return in ? 1 : -1;",
    "}",
    "template <typename T, typename U> bool in_convex(const Point<U> &p, const vc<Point<T>> &c) {",
    "  int n = c.size();",
    "  if (n == 1)",
    "    return p == c[0];",
    "  if (n == 2)",
    "    return on_seg(c[0], c[1], p);",
    "  if (sgn(c[0].cross(c[1], p)) < 0 || sgn(c[0].cross(c[n - 1], p)) > 0)",
    "    return false;",
    "  int l = 1, r = n - 1, m;",
    "  while (r - l > 1) {",
    "    m = l + r >> 1;",
    "    if (sgn(c[0].cross(c[m], p)) >= 0)",
    "      l = m;",
    "    else",
    "      r = m;",
    "  }",
    "  return sgn(c[l].cross(c[r], p)) >= 0;",
    "}",
    "template <typename T> llb max_tri(const vc<Point<T>> &p) { return max_triangle_area(p); }",
    "template <typename T> ll count_boundary(const vc<Point<T>> &p) {",
    "  int n = p.size();",
    "  ll s = 0;",
    "  F(i, 0, n - 1) s += gcd(abs(ll(p[(i + 1) % n].x - p[i].x)), abs(ll(p[(i + 1) % n].y - p[i].y)));",
    "  return s;",
    "}",
