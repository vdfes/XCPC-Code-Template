    "template <typename T> llb min_rect(const vc<Point<T>> &c, vc<Point<T>> *out = nullptr) {",
    "  int n = c.size();",
    "  if (n <= 2)",
    "    return 0;",
    "  llb best = 1e100L;",
    "  int ri = 1, ti = 1, li = 1;",
    "  F(i, 0, n - 1) {",
    "    Point<T> v = c[(i + 1) % n] - c[i];",
    "    while (v.cross(c[(ri + 1) % n] - c[ri]) >= 0)",
    "      ri = (ri + 1) % n;",
    "    if (i == 0)",
    "      li = ri;",
    "    while (v.dot(c[(ti + 1) % n] - c[ti]) >= 0)",
    "      ti = (ti + 1) % n;",
    "    while (v.dot(c[(li + 1) % n] - c[li]) <= 0)",
    "      li = (li + 1) % n;",
    "    llb d2 = llb(v.dot(v));",
    "    llb a = 0, b = llb(v.dot(c[ti] - c[i]));",
    "    llb y1 = 0, y2 = llb(v.cross(c[ri] - c[i]));",
    "    llb S = (b - a) * (y2 - y1) / d2;",
    "    if (S < best) {",
    "      best = S;",
