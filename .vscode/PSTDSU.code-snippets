  "body": [
    "struct PSTDSU {",
    "  struct node {",
    "    int ls, rs, val;",
    "  } t[N << 6];",
    "  int rtfa[N], rtsiz[N];",
    "  int n, cnt;",
    "  void buildfa(int &p, int l, int r) {",
    "    p = ++cnt;",
    "    if (l == r) {",
    "      t[p].val = l;",
    "      return;",
    "    }",
    "    int mid = l + r >> 1;",
    "    buildfa(t[p].ls, l, mid), buildfa(t[p].rs, mid + 1, r);",
    "  }",
    "  void buildsiz(int &p, int l, int r) {",
    "    p = ++cnt;",
    "    if (l == r) {",
    "      t[p].val = 1;",
    "      return;",
    "    }",
    "    int mid = l + r >> 1;",
    "    buildsiz(t[p].ls, l, mid), buildsiz(t[p].rs, mid + 1, r);",
    "  }",
    "  void updatefa(int &p, int ver, int x, int y, int l, int r) { // x <- y",
    "    p = ++cnt;",
    "    t[p] = t[ver];",
    "    if (l == r) {",
    "      t[p].val = x;",
    "      return;",
    "    }",
    "    int mid = l + r >> 1;",
    "    y <= mid ? updatefa(t[p].ls, t[ver].ls, x, y, l, mid) : updatefa(t[p].rs, t[ver].rs, x, y, mid + 1, r);",
    "  }",
    "  void updatesiz(int &p, int ver, int x, int y, int siz, int l, int r) { // x <- y",
    "    p = ++cnt;",
    "    t[p] = t[ver];",
    "    if (l == r) {",
    "      t[p].val = siz;",
    "      return;",
    "    }",
    "    int mid = l + r >> 1;",
    "    x <= mid ? updatesiz(t[p].ls, t[ver].ls, x, y, siz, l, mid) : updatesiz(t[p].rs, t[ver].rs, x, y, siz, mid + 1, r);",
    "  }",
    "  int query(int p, int x, int l, int r) {",
    "    if (l == r)",
    "      return t[p].val;",
    "    int mid = l + r >> 1;",
    "    return x <= mid ? query(t[p].ls, x, l, mid) : query(t[p].rs, x, mid + 1, r);",
    "  }",
    "  int find(int p, int x) {",
    "    int fa = query(p, x, 1, n);",
    "    while (x != fa) {",
    "      x = fa;",
    "      fa = query(p, x, 1, n);",
    "    }",
    "    return x;",
    "  }",
    "  void merge(int u, int v, int x, int y) {",
    "    int fx = find(rtfa[v], x), fy = find(rtfa[v], y);",
    "    if (fx == fy) {",
    "      rtfa[u] = rtfa[v];",
    "      rtsiz[u] = rtsiz[v];",
    "      return;",
    "    }",
    "    int xsiz = query(rtsiz[v], fx, 1, n), ysiz = query(rtsiz[v], fy, 1, n);",
    "    if (xsiz >= ysiz) {",
    "      updatefa(rtfa[u], rtfa[v], fx, fy, 1, n);",
    "      updatesiz(rtsiz[u], rtsiz[v], fx, fy, xsiz + ysiz, 1, n);",
    "    } else {",
    "      updatefa(rtfa[u], rtfa[v], fy, fx, 1, n);",
    "      updatesiz(rtsiz[u], rtsiz[v], fy, fx, xsiz + ysiz, 1, n);",
    "    }",
    "  }",
    "} dsu;"
  ],
  "description": "PSTDSU"
}
